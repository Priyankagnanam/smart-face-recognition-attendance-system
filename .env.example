# ------------------------------------------------------------------
# Smart Face Recognition Attendance System - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit your real `.env` file to git.
# ------------------------------------------------------------------

# REQUIRED in production. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-long-random-string-here

# Optional: initial admin account created on first startup.
# If ADMIN_PASSWORD is not set, a random password is generated and logged once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Database URL (SQLite by default; leave unset for local file database)
DATABASE_URL=sqlite:///database/attendance.db

# 0 = development, 1 = production. debug mode stays off unless FLASK_DEBUG=1
FLASK_ENV=production
FLASK_DEBUG=0

# Set to 1 only when running behind a reverse proxy (e.g. Nginx)
BEHIND_PROXY=0

# Set to 1 to send the session cookie over HTTPS only
SESSION_COOKIE_SECURE=0
