# Copy this file to .env or export these variables in your shell.
# NEVER commit a real SECRET_KEY.

# Required for production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production

# Initial admin account (created on first start if no admin exists).
# If ADMIN_PASSWORD is not set, a strong random password is generated and
# printed once to the application log/console. There is no fixed default.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-too

# Optional: override the SQLite database path (absolute path).
# DATABASE_URL=sqlite:////absolute/path/to/attendance.db

# Optional: set to 1 to enable secure session cookies (only over HTTPS).
# SESSION_COOKIE_SECURE=0

# Optional: set to 1 when running behind a reverse proxy (Nginx/Cloudflare).
# BEHIND_PROXY=0