# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual Environment
venv/
env/
.venv/

# Database (SQLite)
database/attendance.db
database/attendance.db-journal
*.db-wal
*.db-shm
*.db-journal
*.sqlite3

# Datasets (student face images - NEVER commit biometric data)
dataset/*
!dataset/.gitkeep

# Trained Models (contain face encodings - NEVER commit)
trained_models/*
!trained_models/.gitkeep

# Exports
exports/*
!exports/.gitkeep

# Logs
logs/*.log
!logs/.gitkeep

# Uploads
static/uploads/*
!static/uploads/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment (NEVER commit secrets)
.env
*.env
!*.env.example

# Flask instance (contains generated secret keys)
instance/

# Temporary files
*.tmp
*.log
